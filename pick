#!/usr/bin/env python3
import argparse
import random
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kf_common import list_katas, write_json, active_path

def main():
    ap = argparse.ArgumentParser(description="Pick katas for a session")
    ap.add_argument("--count", type=int, default=5)
    ap.add_argument("--katas", type=str, default=None, help="comma-separated ids")
    args = ap.parse_args()

    all_katas = list_katas()
    by_id = {k["id"]: k for k in all_katas}
    if not all_katas:
        print("error: catalog is empty", file=sys.stderr)
        sys.exit(1)

    if args.katas:
        picks = [s.strip() for s in args.katas.split(",") if s.strip()]
        unknown = [p for p in picks if p not in by_id]
        if unknown:
            print(f"error: unknown katas: {', '.join(unknown)}", file=sys.stderr)
            sys.exit(1)
    else:
        ids = [k["id"] for k in all_katas]
        random.shuffle(ids)
        picks = ids[: max(1, min(args.count, len(ids)))]

    write_json(active_path(), picks)
    print(f"Picked {len(picks)} katas: {', '.join(picks)}")
    print(f"active → {active_path()}")

if __name__ == "__main__":
    main()
