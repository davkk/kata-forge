#!/usr/bin/env python3
import argparse
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from kflib.kf_common import (
    active_path,
    ensure_sessions_dir,
    kata_by_id,
    new_session_id,
    read_json,
    render_stub,
    sessions_dir,
    write_json,
)


def main():
    ap = argparse.ArgumentParser(description="Create a practice session")
    ap.add_argument("--katas", type=str, default=None, help="comma-separated kata ids")
    args = ap.parse_args()

    if args.katas:
        picks = [s.strip() for s in args.katas.split(",") if s.strip()]
    else:
        picks = read_json(active_path(), [])

    if not picks:
        print("error: no katas selected", file=sys.stderr)
        sys.exit(1)

    ensure_sessions_dir()
    sid = new_session_id()
    sdir = sessions_dir() / sid
    sdir.mkdir(parents=True, exist_ok=False)

    written = []
    for kid in picks:
        kata = kata_by_id(kid)
        if not kata:
            print(f"error: unknown kata {kid}", file=sys.stderr)
            sys.exit(1)
        path = sdir / f"{kid}.cpp"
        path.write_text(render_stub(kata), encoding="utf-8")
        written.append(kid)

    meta = {
        "id": sid,
        "created": datetime.now(timezone.utc).isoformat(),
        "katas": written,
    }
    write_json(sdir / "meta.json", meta)

    print(f"session: {sdir}")
    for kid in written:
        print(f"  {kid}.cpp")


if __name__ == "__main__":
    main()
