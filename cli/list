#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from kflib.kf_common import list_katas

def main():
    katas = list_katas()
    if not katas:
        print("no katas in catalog/")
        return
    for k in katas:
        title = k.get("title", "")
        print(f"{k['id']:<30}  {title}")

if __name__ == "__main__":
    main()
