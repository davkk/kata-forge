#!/usr/bin/env python3
import argparse
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from kflib.kf_common import kata_by_id, latest_session, read_json
from kflib.fsrs import load_state, review, retrievability_of


def cmd_rate(kid, grade):
    if not kata_by_id(kid):
        print(f"error: unknown kata: {kid}", file=sys.stderr)
        sys.exit(1)
    if grade not in (1, 2, 3, 4):
        print("error: grade must be 1 (again), 2 (hard), 3 (good), or 4 (easy)", file=sys.stderr)
        sys.exit(1)
    card = review(kid, grade)
    print(f"Recorded grade {grade} for {kid}")
    print(f"  difficulty={card['difficulty']:.3f}  stability={card['stability']:.3f}")
    print(f"  reviews={card['review_count']}  lapses={card['lapses']}")


def cmd_state():
    state = load_state()
    if not state:
        print("No FSRS state yet.")
        return
    today = datetime.now(timezone.utc).date()
    print(f"{'kata':<30} {'D':>6} {'S':>8} {'R':>6} {'revs':>4} {'lapses':>6}  last")
    print("-" * 80)
    for kid in sorted(state):
        c = state[kid]
        r = retrievability_of(kid, today)
        lr = c.get("last_review") or "-"
        print(f"{kid:<30} {c['difficulty']:>6.2f} {c['stability']:>8.3f} {r:>6.3f} "
              f"{c['review_count']:>4} {c['lapses']:>6}  {lr}")


def cmd_rate_session():
    session = latest_session()
    if not session:
        print("error: no sessions", file=sys.stderr)
        sys.exit(1)
    meta = read_json(session / "meta.json", {})
    kids = meta.get("katas") or sorted(p.stem for p in session.glob("*.cpp"))
    if not kids:
        print("error: no katas in session", file=sys.stderr)
        sys.exit(1)
    print(f"Rating session {session.name}  (1=again, 2=hard, 3=good, 4=easy, blank=skip)\n")
    for kid in kids:
        inp = input(f"  {kid}: ").strip()
        if not inp:
            print("    skipped\n")
            continue
        try:
            grade = int(inp)
        except ValueError:
            print("    invalid, skipped\n")
            continue
        if grade not in (1, 2, 3, 4):
            print("    invalid, skipped\n")
            continue
        card = review(kid, grade)
        print(f"    D={card['difficulty']:.3f}  S={card['stability']:.3f}\n")


def main():
    ap = argparse.ArgumentParser(description="Record reviews and inspect FSRS state")
    ap.add_argument("--rate", nargs=2, metavar=("KATA", "GRADE"),
                    help="record a review grade (1-4) for a kata")
    ap.add_argument("--state", action="store_true", help="show FSRS state")
    args = ap.parse_args()

    if args.rate:
        cmd_rate(args.rate[0], int(args.rate[1]))
        return

    if args.state:
        cmd_state()
        return

    cmd_rate_session()


if __name__ == "__main__":
    main()
