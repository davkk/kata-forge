{
  "title": "Kadane's Algorithm",
  "shape": "list_scalar",
  "description": "Maximum subarray sum (contiguous).\n",
  "interface": "max_subarray(nums: int[]) -> int\n",
  "tests": [
    {
      "name": "a",
      "in": {
        "arr": [
          -2,
          1,
          -3,
          4,
          -1,
          2,
          1,
          -5,
          4
        ]
      },
      "out": 6
    },
    {
      "name": "b",
      "in": {
        "arr": [
          1
        ]
      },
      "out": 1
    },
    {
      "name": "c",
      "in": {
        "arr": [
          5,
          4,
          -1,
          7,
          8
        ]
      },
      "out": 23
    },
    {
      "name": "d",
      "in": {
        "arr": [
          -1
        ]
      },
      "out": -1
    },
    {
      "name": "e",
      "in": {
        "arr": [
          -2,
          -1
        ]
      },
      "out": -1
    }
  ],
  "id": "kadanes_algorithm"
}
