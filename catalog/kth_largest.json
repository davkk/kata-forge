{
  "title": "Kth Largest Element",
  "shape": "list_k_scalar",
  "description": "Return the k-th largest element in the array (1-based k).\n",
  "interface": "kth_largest(nums: int[], k: int) -> int\n",
  "tests": [
    {
      "name": "a",
      "in": {
        "arr": [
          3,
          2,
          1,
          5,
          6,
          4
        ],
        "k": 2
      },
      "out": 5
    },
    {
      "name": "b",
      "in": {
        "arr": [
          3,
          2,
          3,
          1,
          2,
          4,
          5,
          5,
          6
        ],
        "k": 4
      },
      "out": 4
    },
    {
      "name": "c",
      "in": {
        "arr": [
          1
        ],
        "k": 1
      },
      "out": 1
    },
    {
      "name": "d",
      "in": {
        "arr": [
          2,
          1
        ],
        "k": 1
      },
      "out": 2
    }
  ],
  "id": "kth_largest"
}
