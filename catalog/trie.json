  "interface": "insert(s) delete(s) find(prefix) -> string[]\n",
  "tests": [
    {
      "name": "basic",
      "in": {
        "ops": [
          {
            "op": "insert",
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "insert",
            "sargs": [
              "fool"
            ]
          },
          {
            "op": "insert",
            "sargs": [
              "foolish"
            ]
          },
          {
            "op": "insert",
            "sargs": [
              "bar"
            ]
          },
          {
            "op": "find",
            "sargs": [
              "fo"
            ]
          },
          {
            "op": "delete",
            "sargs": [
              "fool"
            ]
          },
          {
            "op": "find",
            "sargs": [
              "fo"
            ]
          }
        ]
      },
      "out": [
        [
          "foo",
          "fool",
          "foolish"
        ],
        [
