{
  "title": "Two Sum Sorted",
  "shape": "list_k_list",
  "description": "1-indexed pair of indices that sum to target in a sorted array.\n",
  "interface": "two_sum_sorted(nums: int[], target: int) -> int[2]\n",
  "tests": [
    {
      "name": "a",
      "in": {
        "arr": [
          2,
          7,
          11,
          15
        ],
        "k": 9
      },
      "out": [
        1,
        2
      ]
    },
    {
      "name": "b",
      "in": {
        "arr": [
          2,
          3,
          4
        ],
        "k": 6
      },
      "out": [
        1,
        3
      ]
    },
    {
      "name": "c",
      "in": {
        "arr": [
          -1,
          0
        ],
        "k": -1
      },
      "out": [
        1,
        2
      ]
    },
    {
      "name": "d",
      "in": {
        "arr": [
          1,
          2,
          3,
          4,
          5
        ],
        "k": 9
      },
      "out": [
        4,
        5
      ]
    }
  ],
  "id": "two_sum_sorted"
}
