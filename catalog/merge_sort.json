{
  "title": "Merge Sort",
  "shape": "list_inplace",
  "description": "Sort the array ascending in place (Merge Sort).\n",
  "interface": "sort(arr: int[])\n",
  "example": "arr = [9,3,7,4,69,420,42] \u2192 [3,4,7,9,42,69,420]",
  "tests": [
    {
      "name": "basic",
      "in": {
        "arr": [
          9,
          3,
          7,
          4,
          69,
          420,
          42
        ]
      },
      "out": {
        "arr": [
          3,
          4,
          7,
          9,
          42,
          69,
          420
        ]
      }
    },
    {
      "name": "already_sorted",
      "in": {
        "arr": [
          1,
          2,
          3
        ]
      },
      "out": {
        "arr": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "reverse",
      "in": {
        "arr": [
          5,
          4,
          3,
          2,
          1
        ]
      },
      "out": {
        "arr": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "single",
      "in": {
        "arr": [
          42
        ]
      },
      "out": {
        "arr": [
          42
        ]
      }
    },
    {
      "name": "empty",
      "in": {
        "arr": []
      },
      "out": {
        "arr": []
      }
    },
    {
      "name": "duplicates",
      "in": {
        "arr": [
          3,
          1,
          2,
          1,
          3
        ]
      },
      "out": {
        "arr": [
          1,
          1,
          2,
          3,
          3
        ]
      }
    }
  ],
  "id": "merge_sort"
}
