{
  "title": "Find Min in Rotated Sorted Array",
  "shape": "list_scalar",
  "description": "Rotated sorted unique array: find minimum in O(log n).\n",
  "interface": "find_min_rotated(nums: int[]) -> int\n",
  "tests": [
    {
      "name": "a",
      "in": {
        "arr": [
          3,
          4,
          5,
          1,
          2
        ]
      },
      "out": 1
    },
    {
      "name": "b",
      "in": {
        "arr": [
          4,
          5,
          6,
          7,
          0,
          1,
          2
        ]
      },
      "out": 0
    },
    {
      "name": "c",
      "in": {
        "arr": [
          11,
          13,
          15,
          17
        ]
      },
      "out": 11
    },
    {
      "name": "d",
      "in": {
        "arr": [
          1
        ]
      },
      "out": 1
    },
    {
      "name": "e",
      "in": {
        "arr": [
          2,
          1
        ]
      },
      "out": 1
    }
  ],
  "id": "find_min_rotated_sorted"
}
