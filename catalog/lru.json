{
  "title": "LRU Cache",
  "shape": "commands",
  "description": "Least-recently-used cache, capacity via init. get/update by string key, int value.\n",
  "interface": "update(k,v) get(k)\n",
  "tests": [
    {
      "name": "basic",
      "in": {
        "init": [
          3
        ],
        "ops": [
          {
            "op": "get",
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "update",
            "args": [
              69
            ],
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "update",
            "args": [
              420
            ],
            "sargs": [
              "bar"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "bar"
            ]
          },
          {
            "op": "update",
            "args": [
              1337
            ],
            "sargs": [
              "baz"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "baz"
            ]
          },
          {
            "op": "update",
            "args": [
              69420
            ],
            "sargs": [
              "ball"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "ball"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "bar"
            ]
          },
          {
            "op": "update",
            "args": [
              69
            ],
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "bar"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "foo"
            ]
          },
          {
            "op": "get",
            "sargs": [
              "baz"
            ]
          }
        ]
      },
      "out": [
        "empty",
        69,
        420,
        1337,
        69420,
        "empty",
        420,
        420,
        69,
        "empty"
      ]
    }
  ],
  "id": "lru"
}
