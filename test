#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kf_common import (
    LIB_CPP,
    ROOT,
    encode_case,
    kata_by_id,
    latest_session,
    normalize_out,
    sessions_dir,
    values_equal,
)

TIMEOUT_S = 2.0


def find_solution(session: Path, kid: str) -> Path | None:
    for ext in (".cpp", ".cc", ".cxx"):
        p = session / f"{kid}{ext}"
        if p.exists():
            return p
    return None


def compile_cpp(src: Path, out_bin: Path) -> tuple[bool, str]:
    cmd = [
        os.environ.get("CXX", "c++"),
        "-std=c++17",
        "-O2",
        "-Wall",
        f"-I{LIB_CPP}",
        str(src),
        "-o",
        str(out_bin),
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        return False, "c++ compiler not found (set CXX)"
    except subprocess.TimeoutExpired:
        return False, "compile timed out"
    if r.returncode != 0:
        return False, (r.stderr or r.stdout or "compile failed").strip()
    return True, ""


def run_cmd(cmd: list[str] | str, stdin_data: str, env: dict | None = None) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            cmd,
            input=stdin_data,
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
            shell=isinstance(cmd, str),
            env=env,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return -1, "", f"timeout after {TIMEOUT_S}s"


def run_cases(kata: dict, runner) -> tuple[int, int]:
    """runner(stdin_text) -> (rc, stdout, stderr). Returns (passed, total)."""
    shape = kata["shape"]
    tests = kata.get("tests") or []
    passed = 0
    for t in tests:
        name = t.get("name", "?")
        stdin_data = encode_case(shape, t["in"])
        rc, stdout, stderr = runner(stdin_data)
        if rc == -1:
            print(f"  FAIL {name} (timeout)")
            if stderr:
                print(f"    {stderr}")
            continue
        if rc != 0:
            print(f"  FAIL {name} (exit {rc})")
            if stderr.strip():
                print(f"    stderr: {stderr.strip()}")
            continue
        expected, actual = normalize_out(shape, t["out"], stdout)
        if values_equal(expected, actual, shape):
            print(f"  ok  {name}")
            passed += 1
        else:
            print(f"  FAIL {name}")
            print(f"    stdin:\n{ _indent(stdin_data.rstrip()) }")
            print(f"    expected: {expected}")
            print(f"    actual:   {actual}")
            if stdout.strip() != str(actual):
                print(f"    raw stdout:\n{ _indent(stdout.rstrip()) }")
            if stderr.strip():
                print(f"    stderr: {stderr.strip()}")
    return passed, len(tests)


def _indent(s: str, pad: str = "      ") -> str:
    return "\n".join(pad + line for line in s.splitlines())


def test_session(session: Path, filter_kid: str | None = None) -> int:
    meta_path = session / "meta.json"
    if meta_path.exists():
        import json
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
        kids = meta.get("katas") or []
    else:
        kids = []

    # also discover any *.cpp whose stem is a known kata
    if not kids:
        kids = sorted({p.stem for p in session.glob("*.cpp")})

    if filter_kid is not None:
        if filter_kid not in kids:
            print(f"error: {filter_kid} not found in session {session.name}", file=sys.stderr)
            return 1
        kids = [filter_kid]

    print(f"session {session.name}\n")
    total_p = total_t = 0

    with tempfile.TemporaryDirectory(prefix="kata-forge-") as td:
        tdir = Path(td)
        for kid in kids:
            kata = kata_by_id(kid)
            if not kata:
                print(f"{kid}\n  FAIL unknown kata\n")
                continue
            src = find_solution(session, kid)
            print(kid)
            if not src:
                print("  FAIL no solution file (expected <id>.cpp)\n")
                total_t += len(kata.get("tests") or [])
                continue

            bin_path = tdir / kid
            ok, err = compile_cpp(src, bin_path)
            if not ok:
                print(f"  FAIL compile\n    {err}\n")
                total_t += len(kata.get("tests") or [])
                continue

            def runner(stdin_data: str, _bin=bin_path):
                return run_cmd([str(_bin)], stdin_data)

            p, t = run_cases(kata, runner)
            total_p += p
            total_t += t
            print()

    print(f"{total_p}/{total_t} passed")
    return 0 if total_p == total_t and total_t > 0 else 1


def test_cmd(kid: str, cmd: str) -> int:
    kata = kata_by_id(kid)
    if not kata:
        print(f"error: unknown kata {kid}", file=sys.stderr)
        return 1
    print(f"{kid} (--cmd)\n")
    env = os.environ.copy()
    env["KATA_FORGE_ROOT"] = str(ROOT)

    def runner(stdin_data: str):
        return run_cmd(cmd, stdin_data, env=env)

    p, t = run_cases(kata, runner)
    print(f"\n{p}/{t} passed")
    return 0 if p == t and t > 0 else 1


def main():
    ap = argparse.ArgumentParser(description="Run kata tests")
    ap.add_argument("session", nargs="?", help="session id or path (default: latest)")
    ap.add_argument("--kata", type=str, help="kata id (with --cmd)")
    ap.add_argument("--cmd", type=str, help="custom command that speaks shape I/O")
    ap.add_argument("--print-session", action="store_true", help="print latest session path")
    args = ap.parse_args()

    if args.print_session:
        s = latest_session()
        if not s:
            print("error: no sessions", file=sys.stderr)
            sys.exit(1)
        print(s)
        return

    if args.cmd:
        if not args.kata:
            print("error: --cmd requires --kata", file=sys.stderr)
            sys.exit(1)
        sys.exit(test_cmd(args.kata, args.cmd))

    if args.session:
        sp = Path(args.session)
        # treat .cpp file (or bare kata id) as a single-kata selector
        if sp.suffix in (".cpp", ".cc", ".cxx"):
            kid = sp.stem
            session = latest_session()
            if not session:
                print("error: no sessions (run ./generate)", file=sys.stderr)
                sys.exit(1)
            sys.exit(test_session(session, filter_kid=kid))
        if not sp.is_absolute():
            cand = sessions_dir() / args.session
            sp = cand if cand.exists() else sp
        session = sp.resolve()
    else:
        session = latest_session()
        if not session:
            print("error: no sessions (run ./generate)", file=sys.stderr)
            sys.exit(1)

    if not session.is_dir():
        print(f"error: session not found: {session}", file=sys.stderr)
        sys.exit(1)

    sys.exit(test_session(session))


if __name__ == "__main__":
    main()
