#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kf_common import (
    ROOT,
    TESTS_DIR,
    kata_by_id,
    latest_session,
    sessions_dir,
)

TIMEOUT_S = 2.0
CXX = os.environ.get("CXX", "c++")
TMP_BIN = Path("/tmp") / "kata-forge-test"


def compile_with_include(src: Path, include_path: Path, out_bin: Path) -> tuple[bool, str]:
    cmd = [
        CXX,
        "-std=c++17",
        "-O2",
        "-Wall",
        f"-include", str(include_path.resolve()),
        str(src.resolve()),
        "-o",
        str(out_bin),
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        return False, "c++ compiler not found (set CXX)"
    except subprocess.TimeoutExpired:
        return False, "compile timed out"
    if r.returncode != 0:
        return False, (r.stderr or r.stdout or "compile failed").strip()
    return True, ""


def run_bin(bin_path: Path) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            [str(bin_path)],
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return -1, "", f"timeout after {TIMEOUT_S}s"


def test_session(session: Path, filter_kid: str | None = None) -> int:
    meta_path = session / "meta.json"
    if meta_path.exists():
        import json
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
        kids = meta.get("katas") or []
    else:
        kids = []

    if not kids:
        kids = sorted({p.stem for p in session.glob("*.cpp")})

    if filter_kid is not None:
        if filter_kid not in kids:
            print(f"error: {filter_kid} not found in session {session.name}", file=sys.stderr)
            return 1
        kids = [filter_kid]

    print(f"session {session.name}\n")
    total_p = total_t = 0

    for kid in kids:
        src = session / f"{kid}.cpp"
        print(kid)
        if not src.exists():
            print("  FAIL no solution file\n")
            total_t += 1
            continue

        kata = kata_by_id(kid)
        if not kata:
            print("  FAIL unknown kata\n")
            total_t += 1
            continue

        test_src = TESTS_DIR / f"{kid}.test.cpp"
        if not test_src.exists():
            print("  FAIL missing shared test harness (run ./generate --harnesses)\n")
            total_t += 1
            continue

        bin_path = TMP_BIN / kid
        bin_path.parent.mkdir(parents=True, exist_ok=True)
        ntests = test_src.read_text().count("assert(")

        ok, err = compile_with_include(test_src, src, bin_path)
        if not ok:
            print(f"  FAIL compile\n    {err}\n")
            total_t += ntests or 1
            continue

        rc, stdout, stderr = run_bin(bin_path)
        if rc == -1:
            print(f"  FAIL (timeout)\n")
            total_t += ntests or 1
            if stderr:
                print(f"    {stderr}")
            continue
        if rc == 0:
            print(f"  ok  {ntests}/{ntests} passed")
            total_p += ntests
            total_t += ntests
        else:
            total_t += ntests or 1
            print(f"  FAIL (exit {rc})")
            if stdout.strip():
                print(f"    {stdout.strip()}")
            if stderr.strip():
                print(f"    {stderr.strip()}")
            if stdout.strip():
                for line in stdout.strip().splitlines()[-3:]:
                    print(f"    > {line}")

        print()

    print(f"{total_p}/{total_t} passed")
    return 0 if total_p == total_t and total_t > 0 else 1


def main():
    import argparse
    ap = argparse.ArgumentParser(description="Run kata tests")
    ap.add_argument("session", nargs="?", help="session id/path or .cpp filename")
    ap.add_argument("--print-session", action="store_true", help="print latest session path")
    args = ap.parse_args()

    if args.print_session:
        s = latest_session()
        if not s:
            print("error: no sessions", file=sys.stderr)
            sys.exit(1)
        print(s)
        return

    if args.session:
        sp = Path(args.session)
        if sp.suffix == ".cpp":
            kid = sp.stem
            session = latest_session()
            if not session:
                print("error: no sessions (run ./generate)", file=sys.stderr)
                sys.exit(1)
            sys.exit(test_session(session, filter_kid=kid))
        if not sp.is_absolute():
            cand = sessions_dir() / args.session
            sp = cand if cand.exists() else sp
        session = sp.resolve()
    else:
        session = latest_session()
        if not session:
            print("error: no sessions (run ./generate)", file=sys.stderr)
            sys.exit(1)

    if not session.is_dir():
        print(f"error: session not found: {session}", file=sys.stderr)
        sys.exit(1)

    sys.exit(test_session(session))


if __name__ == "__main__":
    main()
